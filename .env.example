# ==============================================================================
# KancaSela - Environment Variables Template (.env.example)
# ==============================================================================
#
# Environment URL Architecture:
# - Local Dev:   Main: https://kancasela.test     | Admin: https://admin.kancasela.test
# - Staging:     Main: https://koncoselo.my.id    | Admin: https://admin.koncoselo.my.id
# - Production:  Main: https://kancasela.my.id     | Admin: https://admin.kancasela.my.id
# ==============================================================================

# Application Base Origin (Optional override for serverless redirects)
# Local: https://kancasela.test | Staging: https://koncoselo.my.id | Prod: https://kancasela.my.id
APP_URL=https://kancasela.my.id

# Supabase BaaS (Local Docker: http://127.0.0.1:54341 | Staging/Prod: https://xxx.supabase.co)
VITE_SUPABASE_URL=http://127.0.0.1:54341
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Ads Integration (AdSense & AdMob)
VITE_ADS_TEST_MODE=true
VITE_ADSENSE_CLIENT_ID="ca-pub-5832618604638694"
VITE_ADSENSE_BANNER_SLOT_ID="1234567890"
VITE_ADMOB_BANNER_ID="ca-app-pub-3940256099942544/6300978111"
VITE_ADMOB_INTERSTITIAL_ID="ca-app-pub-3940256099942544/1033173712"
VITE_ADMOB_REWARDED_ID="ca-app-pub-3940256099942544/5224354917"

# Midtrans Payment Gateway (Sandbox: SB-Mid-... | Production: Mid-...)
VITE_MIDTRANS_CLIENT_KEY="SB-Mid-client-sample-sandbox-key"
VITE_MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY="SB-Mid-server-sample-sandbox-key"

